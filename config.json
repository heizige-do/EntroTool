      "contract_filter": {
        "enabled": true,
        "minimum_required_jaccard": 0.15,
        "semantic_contract_fallback": {
          "enabled": true,
          "minimum_cosine": 0.94
        }
      },
      "batch_size": 64,
      "search_chunk_size": 256,
      "device": "cuda",
      "show_progress": true,
      "use_faiss": true
    }
  },
  "retriever": {
    "embedding_model": "../../models/gte-large",
